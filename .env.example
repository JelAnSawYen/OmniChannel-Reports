APP_NAME="OmniChannel Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8011

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
SERVER_HOST=127.0.0.1
SERVER_PORT=8011
APP_TIMEZONE=Asia/Manila

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Internal server must use MySQL. Copy this file to .env, set APP_KEY, then
# php artisan migrate --force. Do not commit .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=omnichannel_reports
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Local HTTP: false. Production HTTPS: true, with APP_ENV=production, APP_DEBUG=false, APP_URL=https://...
SESSION_SECURE_COOKIE=false

# Comma-separated reverse-proxy IPs. Leave empty for direct access. Never use *.
# Production values require server verification of the actual load balancer addresses.
TRUSTED_PROXIES=

# Optional full path when mysqldump/mysql are not on PATH. REQUIRES SERVER VERIFICATION.
# MYSQLDUMP_PATH=
# MYSQL_CLIENT_PATH=

# This internal app does not use MFA/2FA.
SECURITY_MFA=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="OmniChannel Inventory"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
